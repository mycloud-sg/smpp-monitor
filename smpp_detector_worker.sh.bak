#!/usr/bin/env bash

set -u


########################################
# SMPP Detector Worker
#
# 定时扫描所有供应商 pcap
#
########################################


BASE_DIR="/root/smpp_monitor"

CONFIG_FILE="$BASE_DIR/smpp_suppliers.conf"

DETECTOR="$BASE_DIR/smpp_detector.py"

INCIDENT="$BASE_DIR/smpp_incident.sh"


INTERVAL="${INTERVAL:-10}"

PID_DIR="$BASE_DIR/pids"


mkdir -p "$PID_DIR"


PID_FILE="$PID_DIR/detector.pid"



echo $$ > "$PID_FILE"



cleanup()
{
    echo "$(date '+%F %T') detector stopped"

    rm -f "$PID_FILE"

    exit 0
}


trap cleanup TERM INT



echo "================================"
echo "SMPP Detector Worker"
echo "================================"

echo "interval: ${INTERVAL}s"



########################################
# 获取供应商列表
########################################

get_suppliers()
{

    grep '^\[' "$CONFIG_FILE" \
    | sed 's/\[//g;s/\]//g'

}



########################################
# 防止重复 incident
########################################

LOCK_DIR="$BASE_DIR/locks"

mkdir -p "$LOCK_DIR"



########################################
# 主循环
########################################


while true
do


    for supplier in $(get_suppliers)
    do


        python3 "$DETECTOR" "$supplier" \
            > /tmp/smpp_detector_${supplier}.log 2>&1



        RET=$?



        if [ "$RET" -eq 2 ]
        then


            LOCK="$LOCK_DIR/${supplier}.lock"


            #
            # 避免同一个故障连续生成几十个 incident
            #

            if [ ! -f "$LOCK" ]
            then


                echo "$(date '+%F %T') incident detected $supplier"


                touch "$LOCK"



                bash "$INCIDENT" "$supplier"



            fi


        else


            #
            # 恢复后解除锁
            #

            rm -f "$LOCK_DIR/${supplier}.lock"


        fi



    done



    sleep "$INTERVAL"



done
