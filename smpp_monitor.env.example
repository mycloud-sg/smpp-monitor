# Copy to smpp_monitor.env (not tracked by git) and edit for this host.
# smpp_capture_manager.sh loads it on every start/restart; variables already
# set in the shell take precedence.

# Copy incidents to the aurora web backend (SMPP 事故 page)
EXPORT_DIR=/www/wwwroot/aurora/runtime/smpp_incidents
EXPORT_GROUP=www

# INCIDENT_RETENTION_HOURS=24
# NETPROBE=1
